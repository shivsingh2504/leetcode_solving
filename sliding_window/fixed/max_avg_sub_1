class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        double res = 0.0;
        double curr = 0.0;
        for (int i = 0; i < k; i++) {
            curr += nums[i];
        }
        res = curr / k;

        for (int i = k; i < nums.size(); i++) {
            curr += nums[i];
            curr -= nums[i-k];
            res = max(res, curr / k);
        }
        return res;
    }
};